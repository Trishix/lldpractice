# Platform Groq credential. Leave blank to run MCQ-only practice without AI review.
GROQ_API_KEY=

# Optional phase-specific credentials. When set, these take precedence for the
# matching review phase and fall back to GROQ_API_KEY when unavailable.
GROQ_REVIEW_API_KEY=
GROQ_FINAL_REVIEW_API_KEY=
GROQ_FALLBACK_API_KEY=

# Optional key used only by the calibration scripts.
GROQ_CALIBRATION_API_KEY=

# Optional: set to 1 to enable live calibration tests.
CALIBRATION_LIVE=0